{
  "name": "mova-flow",
  "version": "0.4.9",
  "description": "Mova Flow — a local transcription app built on Electron + whisper.cpp, no Python required.",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/renderer.js && node -e \"require('fs').mkdirSync('dist/renderer',{recursive:true});require('fs').copyFileSync('src/renderer/index.html','dist/renderer/index.html');require('fs').copyFileSync('src/renderer/style.css','dist/renderer/style.css')\"",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build && electron .",
    "dist": "npm run build && npm run build:native && electron-builder --publish never",
    "build:native": "node scripts/build-native.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "build": {
    "appId": "com.movaflow.app",
    "productName": "Mova Flow",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "f3an",
        "repo": "Mova-Flow"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.png",
      "build/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Mova-Flow-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Mova-Flow-${version}-${arch}-mac.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Mova Flow connects to other Mova Flow hosts on your local network to send audio for transcription, and discovers them automatically via Bonjour.",
        "NSBonjourServices": [
          "_mova-flow._tcp"
        ],
        "NSMicrophoneUsageDescription": "Mova Flow records your microphone when you record a call, so your side of the conversation can be transcribed.",
        "NSAudioCaptureUsageDescription": "Mova Flow records the call audio playing on this Mac when you record a call, so the other side of the conversation can be transcribed."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/bin/mova-audio-tap",
          "to": "bin/mova-audio-tap"
        }
      ]
    },
    "dmg": {
      "artifactName": "Mova-Flow-${version}.${ext}",
      "contents": [
        {
          "x": 180,
          "y": 190,
          "type": "file"
        },
        {
          "x": 480,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  }
}
