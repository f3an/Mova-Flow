{
  "name": "mova-flow",
  "version": "0.1.8",
  "description": "Mova Flow — a local transcription app built on Electron + whisper.cpp, no Python required.",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/renderer.js && node -e \"require('fs').mkdirSync('dist/renderer',{recursive:true});require('fs').copyFileSync('src/renderer/index.html','dist/renderer/index.html');require('fs').copyFileSync('src/renderer/style.css','dist/renderer/style.css')\"",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "build": {
    "appId": "com.movaflow.app",
    "productName": "Mova Flow",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "f3an",
        "repo": "Mova-Flow"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.png",
      "build/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Mova-Flow-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Mova Flow connects to other Mova Flow hosts on your local network to send audio for transcription, and discovers them automatically via Bonjour.",
        "NSBonjourServices": [
          "_mova-flow._tcp"
        ]
      }
    },
    "dmg": {
      "artifactName": "Mova-Flow-${version}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 60,
          "type": "file",
          "path": "build/Install & Open.command",
          "name": "Install & Open.command"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  }
}
